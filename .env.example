NODE_ENV=production
PORT=3000
DATABASE_PATH=./data/jaaykat.db
PUBLIC_URL=
BITNOB_MODE=mock
BITNOB_AUTO_SETTLE=true
# auto : facture Bitnob dès la création. manual : facture locale, paiement simulé via POST /api/public/invoices/:id/pay
DEMO_PAY_MODE=auto
BITNOB_PAYOUT_FROM_ASSET=USDT
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
PHONE_PEPPER=
PAYER_PEPPER=
NODE_OPTIONS=--dns-result-order=ipv4first
