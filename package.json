{
  "name": "jaaykat-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts",
    "admin:reset-pin": "tsx src/admin/reset-pin.ts",
    "sandbox:check": "tsx scripts/sandbox-check.ts",
    "sync:web": "bash scripts/sync-web.sh"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^11.10.0",
    "bitnob-lite": "file:../bitnob-lite",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
